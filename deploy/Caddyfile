# Caddy obtains and renews the Let's Encrypt certificate itself. The app
# listens on loopback only; this is the only way in.
multipass.video {
	# Every seek a player makes is a new range request for the media, so
	# the access log is a second account of what a TV does, independent of
	# the page's own trace.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 3
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		# SSE: a proxy that buffers the response would hold every schedule
		# change until the buffer filled. Caddy flushes by default for
		# text/event-stream, but say so.
		flush_interval -1
	}
}
